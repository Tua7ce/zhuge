---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "fs";

var predRaw;
try { predRaw = JSON.parse(readFileSync("src/data/predictions.json","utf-8")); } catch(e) { predRaw = {error:"no_data"}; }
var histRaw;
try { histRaw = JSON.parse(readFileSync("src/data/history.json","utf-8")); } catch(e) { histRaw = []; }

var hasData = !predRaw.error;
var tn = hasData ? (predRaw.topNumbers||[]).slice(0,7) : [];
var z3 = hasData ? (predRaw.zodiacCombos||{})["3zod3num"]||[] : [];
var z4 = hasData ? (predRaw.zodiacCombos||{})["4zod4num"]||[] : [];
var z5 = hasData ? (predRaw.zodiacCombos||{})["5zod5num"]||[] : [];
var bd = hasData ? (predRaw.budgetStrategies||{}) : {};
var latest10 = histRaw.slice(-10).reverse();
var status = hasData ? "第"+predRaw.nextIssue+"期 · 共"+predRaw.totalPeriods+"期" : "暂无数据";
var lastSpecial = predRaw.latestSpecial || 0;
var lastZodiac = predRaw.latestZodiac || "-";
var bud100 = bd["100"]||[]; var bud200 = bd["200"]||[]; var bud300 = bd["300"]||[]; var bud400 = bd["400"]||[];
var topZods = hasData ? (predRaw.topZodiacs||[]).slice(0,5) : [];
function pad(n){return ("0"+n).slice(-2);}
function color(n){
  var r=[1,2,7,8,12,13,18,19,23,24,29,30,34,35,40,45,46];
  var b=[3,4,9,10,14,15,20,25,26,31,36,37,41,42,47,48];
  if(r.indexOf(n)>=0)return "red";if(b.indexOf(n)>=0)return "blue";return "green";
}
var nc={red:"#e74c3c",blue:"#3498db",green:"#2ecc71"};
function ball(n,s){var c=nc[color(n)]||"#888";return "<div class=num-item><div class=num-ball style=background:"+c+">"+pad(n)+"</div><div class=num-zod style=color:"+c+">"+s+"</div></div>";}
function renderNums(arr){return arr.map(function(x){return ball(x.number,x.zodiac);}).join("");}
---

<Layout>
  <div class=card style="text-align:center">
    <div style="font-size:14px;color:var(--text2)">{status}</div>
    <div style="font-size:13px;color:var(--text2);margin-top:4px">上期特码: <b style="font-size:18px;color:var(--gold)">{pad(lastSpecial)}</b> ({lastZodiac})</div>
  </div>

  <div class=card>
    <h2>纯数字推荐 <span class=ac>Top7</span></h2>
    <div class=num-row set:html={hasData ? renderNums(tn) : "<p style=color:var(--text2);font-size:14px>暂无预测数据</p>"}></div>
  </div>

  <div class=card>
    <h2>生肖组合</h2>
    <div style="margin-bottom:10px">
      <div style="font-size:13px;font-weight:600;color:var(--gold);margin-bottom:4px">3生肖 + 3数字</div>
      <div class=num-row><Fragment set:html={hasData&&z3.length>0?renderNums(z3):"<span style=color:var(--text2);font-size:13px>暂无</span>"} /></div>
    </div>
    <div style="margin-bottom:10px">
      <div style="font-size:13px;font-weight:600;color:var(--gold);margin-bottom:4px">4生肖 + 4数字</div>
      <div class=num-row><Fragment set:html={hasData&&z4.length>0?renderNums(z4):"<span style=color:var(--text2);font-size:13px>暂无</span>"} /></div>
    </div>
    <div>
      <div style="font-size:13px;font-weight:600;color:var(--gold);margin-bottom:4px">5生肖 + 5数字</div>
      <div class=num-row><Fragment set:html={hasData&&z5.length>0?renderNums(z5):"<span style=color:var(--text2);font-size:13px>暂无</span>"} /></div>
    </div>
  </div>

  <div class=card id=budget-section>
    <h2>投注预算策略</h2>
    <div class=tab-bar>
      <div class="tab-item active" data-budget=100 onclick="switchBudget(100)">100元</div>
      <div class=tab-item data-budget=200 onclick="switchBudget(200)">200元</div>
      <div class=tab-item data-budget=300 onclick="switchBudget(300)">300元</div>
      <div class=tab-item data-budget=400 onclick="switchBudget(400)">400元</div>
    </div>
    <div id=budget-content></div>
  </div>

  <div class=card>
    <h2>近期开奖 <span class=ac>最近10期</span></h2>
    <table class=ht>
      <thead><tr><th>期号</th><th>日期</th><th>号码</th><th>特码</th></tr></thead>
      <tbody>
        {latest10.map(function(h){
          var ns=h.numbers[6];var zs=h.zodiacs[6];
          var regBalls = h.numbers.slice(0,6).map(function(n,i){
            var c=nc[color(n)]||"#888";
            return "<span class=ball-sm style=background:"+c+">"+pad(n)+"</span>";
          }).join("");
          var specBall = "<span class=ball-sm style=background:"+(nc[color(ns)]||"#888")+";border:2px solid var(--gold)>"+pad(ns)+"</span>";
          return "<tr><td>"+h.issue+"</td><td>"+h.date+"</td><td>"+regBalls+"</td><td>"+specBall+"<span class=zod-sm>"+zs+"</span></td></tr>";
        }).join("")}
      </tbody>
    </table>
  </div>

  <div class=card>
    <h2>命中率追踪</h2>
    <div id=accuracy>
      <div style="text-align:center;padding:12px;color:var(--text2);font-size:14px">开奖后自动记录命中率</div>
    </div>
  </div>
</Layout>

<script is:inline>
var BD = JSON.parse(document.getElementById("budget-data")?.textContent || "{}");
function switchBudget(b){
  document.querySelectorAll("#budget-section .tab-item").forEach(function(t){t.classList.toggle("active",+t.dataset.budget===b);});
  var plans = BD[b] || [];
  var el = document.getElementById("budget-content");
  if (!el) return;
  if (plans.length === 0) {
    el.innerHTML = "<div style=text-align:center;padding:16px;color:var(--text2)>暂无该预算方案，请先运行预测</div>";
    return;
  }
  var best = plans[0];
  var html = "<div style=background:#fffdf5;border:1px solid var(--gold);border-radius:6px;padding:12px;margin-bottom:8px>";
  html += "<div style=font-size:15px;font-weight:600;color:var(--gold)>推荐方案</div>";
  html += "<div style=display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px>";
  html += "<div><span style=color:var(--text2)>投入</span><br><b style=font-size:18px>"+best.cost+"元</b></div>";
  html += "<div><span style=color:var(--text2)>命中率</span><br><b style=font-size:18px;color:var(--gold)>"+best.prob+"%</b></div>";
  html += "<div><span style=color:var(--text2)>覆盖号码</span><br><b style=font-size:18px>"+best.nums+"个</b></div>";
  html += "<div><span style=color:var(--text2)>中赚</span><br><b style=font-size:18px;color:"+(best.profit>0?"#27ae60":"var(--red)")+">"+best.profit+"元</b></div>";
  html += "</div></div>";
  html += "<div style=font-size:12px;color:var(--text2);margin-bottom:6px>其他方案:</div>";
  for (var i = 1; i < plans.length && i < 4; i++) {
    var p = plans[i];
    html += "<div style=display:flex;justify-content:space-between;padding:6px 8px;border-bottom:1px solid #f0ede6;font-size:13px>";
    html += "<span>"+p.nums+"码 ("+(p.zodiacs&&p.zodiacs.length?p.zodiacs.join("+"):"纯数字")+")</span>";
    html += "<span>"+p.prob+"% · "+(p.profit>0?"+":"")+p.profit+"元</span></div>";
  }
  el.innerHTML = html;
}
switchBudget(100);
</script>
<script is:inline id=budget-data type=application/json>{JSON.stringify(bd)}</script>

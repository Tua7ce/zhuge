---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "fs";
var histRaw;
try { histRaw = JSON.parse(readFileSync("src/data/history.json","utf-8")); } catch(e) { histRaw = []; }
var predRaw;
try { predRaw = JSON.parse(readFileSync("src/data/predictions.json","utf-8")); } catch(e) { predRaw = {}; }
var specials = histRaw.map(function(h){return h.numbers[6];});
var labels = histRaw.map(function(h){return String(h.issue).slice(-3);});
---
<Layout title="图表分析 - 诸葛六合">
  <div class=card>
    <h2>特码走势 <span class=ac>近50期</span></h2>
    <div id=trend style="width:100%;height:320px"></div>
  </div>
  <div class=card>
    <h2>号码频率分布 <span class=ac>1-49</span></h2>
    <div id=freq style="width:100%;height:380px"></div>
  </div>
</Layout>
<script is:inline define:vars={{ SERIES: specials, LABELS: labels }}>
var s = SERIES;
var l = LABELS;
var n = {};
for(var i=1;i<=49;i++) n[i] = 0;
for(var j=0;j<s.length;j++) n[s[j]]++;

var script = document.createElement("script");
script.src = "https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js";
script.onload = function(){
  // Trend chart
  var r50 = s.slice(-50);
  var l50 = l.slice(-50);
  var t = echarts.init(document.getElementById("trend"));
  t.setOption({
    tooltip:{trigger:"axis",backgroundColor:"#faf6ec",borderColor:"#d9cfb9",textStyle:{color:"#22211e",fontSize:12}},
    xAxis:{type:"category",data:l50,axisLabel:{fontSize:10,color:"#6b665c"},axisLine:{lineStyle:{color:"#d9cfb9"}},splitLine:{lineStyle:{color:"rgba(217,207,185,.55)"}}},
    yAxis:{type:"value",min:1,max:49,axisLabel:{fontSize:10,color:"#6b665c"},splitLine:{lineStyle:{color:"rgba(217,207,185,.55)"}}},
    series:[{
      type:"line",data:r50,smooth:true,
      lineStyle:{color:"#1e4f3c",width:2.5},
      itemStyle:{color:"#b5862f"},
      areaStyle:{color:"rgba(30,79,60,0.1)"},
      markLine:{data:[{yAxis:25,label:{formatter:"中位线",color:"#6b665c",fontSize:10}}],lineStyle:{color:"#8f846f",type:"dashed"}}
    }]
  });
  
  // Frequency chart
  var fData = []; for(var k=1;k<=49;k++) fData.push({value:n[k],name:String(k).padStart(2,"0")});
  var fc = echarts.init(document.getElementById("freq"));
  fc.setOption({
    tooltip:{trigger:"axis",backgroundColor:"#faf6ec",borderColor:"#d9cfb9",textStyle:{color:"#22211e",fontSize:12}},
    xAxis:{type:"category",data:fData.map(function(x){return x.name;}),axisLabel:{fontSize:9,rotate:45,color:"#6b665c"},axisLine:{lineStyle:{color:"#d9cfb9"}}},
    yAxis:{type:"value",axisLabel:{fontSize:10,color:"#6b665c"},splitLine:{lineStyle:{color:"rgba(217,207,185,.55)"}}},
    series:[{
      type:"bar",data:fData,barMaxWidth:18,
      itemStyle:{
        color:function(p){var v=["#c0392b","#2e6c96","#3a8a4e"][p.dataIndex%3];return v;},
        borderRadius:[3,3,0,0]
      }
    }]
  });
  
  window.addEventListener("resize",function(){t.resize();fc.resize();});
};
document.head.appendChild(script);
</script>

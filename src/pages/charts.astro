---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "fs";
var histRaw;
try { histRaw = JSON.parse(readFileSync("src/data/history.json","utf-8")); } catch(e) { histRaw = []; }
var predRaw;
try { predRaw = JSON.parse(readFileSync("src/data/predictions.json","utf-8")); } catch(e) { predRaw = {}; }
var specials = histRaw.map(function(h){return h.numbers[6];});
var labels = histRaw.map(function(h){return String(h.issue).slice(-3);});
---
<Layout title="图表分析 - 梦想版本-澳门六合彩">
  <div class=card>
    <h2>特码走势 <span class=ac>近50期</span></h2>
    <div id=trend style="width:100%;height:320px"></div>
  </div>
  <div class=card>
    <h2>号码频率分布 <span class=ac>1-49</span></h2>
    <div id=freq style="width:100%;height:380px"></div>
  </div>
</Layout>
<script is:inline>
var s = {JSON.stringify(specials)};
var l = {JSON.stringify(labels)};
var n = {};
for(var i=1;i<=49;i++) n[i] = 0;
for(var j=0;j<s.length;j++) n[s[j]]++;

var script = document.createElement("script");
script.src = "https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js";
script.onload = function(){
  // Trend chart
  var r50 = s.slice(-50);
  var l50 = l.slice(-50);
  var t = echarts.init(document.getElementById("trend"));
  t.setOption({
    tooltip:{trigger:"axis"},
    xAxis:{type:"category",data:l50,axisLabel:{fontSize:10}},
    yAxis:{type:"value",min:1,max:49},
    series:[{
      type:"line",data:r50,smooth:true,
      lineStyle:{color:"#c9a959",width:2},
      itemStyle:{color:"#c9a959"},
      areaStyle:{color:"rgba(201,169,89,0.1)"},
      markLine:{data:[{yAxis:25,label:{formatter:"中位线",color:"#888",fontSize:10}}],lineStyle:{color:"#ddd",type:"dashed"}}
    }]
  });
  
  // Frequency chart
  var fData = []; for(var k=1;k<=49;k++) fData.push({value:n[k],name:String(k).padStart(2,"0")});
  var fc = echarts.init(document.getElementById("freq"));
  fc.setOption({
    tooltip:{trigger:"axis"},
    xAxis:{type:"category",data:fData.map(function(x){return x.name;}),axisLabel:{fontSize:9,rotate:45}},
    yAxis:{type:"value"},
    series:[{
      type:"bar",data:fData,
      itemStyle:{
        color:function(p){var v=["#e74c3c","#3498db","#2ecc71"][p.dataIndex%3];return v;}
      }
    }]
  });
  
  window.addEventListener("resize",function(){t.resize();fc.resize();});
};
document.head.appendChild(script);
</script>

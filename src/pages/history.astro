---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "fs";
var histRaw;
try { histRaw = JSON.parse(readFileSync("src/data/history.json","utf-8")); } catch(e) { histRaw = []; }
var count = histRaw.length;
var col = {red:"#c0392b",blue:"#2e6c96",green:"#3a8a4e"};
function pad(n){return ("0"+n).slice(-2);}
function color(n){var r=[1,2,7,8,12,13,18,19,23,24,29,30,34,35,40,45,46];var b=[3,4,9,10,14,15,20,25,26,31,36,37,41,42,47,48];if(r.indexOf(n)>=0)return "red";if(b.indexOf(n)>=0)return "blue";return "green";}
function ball(n,sz){
  var c=col[color(n)]||"#888";var s=sz||22;var f=s>25?12:9;
  return "<span style=display:inline-flex;width:"+s+"px;height:"+s+"px;line-height:"+s+"px;border-radius:50%;background:"+c+";color:#fff;font-size:"+f+"px;font-weight:700;text-align:center;margin:0 1px>"+pad(n)+"</span>";
}
var zn = ["鼠","牛","虎","兔","龙","蛇","马","羊","猴","鸡","狗","猪"];
var ZN = {};for(var i=0;i<zn.length;i++)ZN[zn[i]]=true;
---
<Layout title="开奖记录 - 诸葛六合">
  <div class=card>
    <h2>全部开奖记录 <span class=ac>{count}期</span></h2>
    <div style="display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap">
      <input id=search class=field placeholder="搜索期号" style="flex:1;min-width:100px">
      <select id=filter class=field>
        <option value="">全部生肖</option>
        {zn.map((z) => <option value={z}>{z}</option>)}
      </select>
    </div>
    <table class=ht>
      <thead><tr><th>期号</th><th>日期</th><th>号码</th><th>特码</th></tr></thead>
      <tbody id=tbody></tbody>
    </table>
    <div class=pg id=pagination></div>
  </div>
</Layout>
<script is:inline define:vars={{ DATA: histRaw.map(function (h, i) { return { issue: h.issue, date: h.date, numbers: h.numbers, zodiacs: h.zodiacs, idx: i }; }) }}>
var PS = 15, HP = 1, filtered = DATA;

function render(){
  var q = (document.getElementById("search").value||"").trim();
  var zf = document.getElementById("filter").value;
  filtered = DATA;
  if(q) filtered = filtered.filter(function(d){return String(d.issue).indexOf(q)>=0;});
  if(zf) filtered = filtered.filter(function(d){return d.zodiacs[6]===zf;});
  var tt = filtered.length, pg = Math.ceil(tt/PS), st = (HP-1)*PS, en = Math.min(st+PS,tt);
  var html = "";
  for(var i=st;i<en;i++){
    var d=filtered[i],ns=d.numbers,zs=d.zodiacs;
    html += "<tr><td>"+d.issue+"</td><td>"+d.date+"</td><td>";
    for(var j=0;j<6;j++) html += SPAN(ns[j],zs[j],22);
    html += '</td><td><span style=display:inline-flex;flex-direction:column;align-items:center;gap:2px>';
    html += BALL(ns[6],zs[6]);
    html += "</span></td></tr>";
  }
  document.getElementById("tbody").innerHTML = html;
  var ph = [];
  ph.push('<button onclick=go('+(HP-1)+') '+(HP<=1?'disabled':'')+'>◀</button>');
  for(var pp=Math.max(1,HP-2);pp<=Math.min(pg,HP+2);pp++) ph.push('<button onclick=go('+pp+') class='+(pp===HP?'active':'')+'>'+pp+'</button>');
  ph.push('<button onclick=go('+(HP+1)+') '+(HP>=pg?'disabled':'')+'>▶</button>');
  ph.push('<span style=font-size:11px;color:var(--ink-2);margin-left:4px>'+tt+'期</span>');
  document.getElementById("pagination").innerHTML = ph.join("");
}
function SPAN(n,z,s){var c={1:"#c0392b",2:"#c0392b",7:"#c0392b",8:"#c0392b",12:"#c0392b",13:"#c0392b",18:"#c0392b",19:"#c0392b",23:"#c0392b",24:"#c0392b",29:"#c0392b",30:"#c0392b",34:"#c0392b",35:"#c0392b",40:"#c0392b",45:"#c0392b",46:"#c0392b",3:"#2e6c96",4:"#2e6c96",9:"#2e6c96",10:"#2e6c96",14:"#2e6c96",15:"#2e6c96",20:"#2e6c96",25:"#2e6c96",26:"#2e6c96",31:"#2e6c96",36:"#2e6c96",37:"#2e6c96",41:"#2e6c96",42:"#2e6c96",47:"#2e6c96",48:"#2e6c96",5:"#3a8a4e",6:"#3a8a4e",11:"#3a8a4e",16:"#3a8a4e",17:"#3a8a4e",21:"#3a8a4e",22:"#3a8a4e",27:"#3a8a4e",28:"#3a8a4e",32:"#3a8a4e",33:"#3a8a4e",38:"#3a8a4e",39:"#3a8a4e",43:"#3a8a4e",44:"#3a8a4e",49:"#3a8a4e"}[n];return '<span style="display:inline-flex;flex-direction:column;align-items:center;margin:0 2px"><span class=ball-sm style="background:'+c+'">'+n+'</span><span style="font-size:11px;color:var(--ink-2)">'+z+"</span></span>";}
function BALL(n,z){
  var c={1:"#c0392b",2:"#c0392b",7:"#c0392b",8:"#c0392b",12:"#c0392b",13:"#c0392b",18:"#c0392b",19:"#c0392b",23:"#c0392b",24:"#c0392b",29:"#c0392b",30:"#c0392b",34:"#c0392b",35:"#c0392b",40:"#c0392b",45:"#c0392b",46:"#c0392b",3:"#2e6c96",4:"#2e6c96",9:"#2e6c96",10:"#2e6c96",14:"#2e6c96",15:"#2e6c96",20:"#2e6c96",25:"#2e6c96",26:"#2e6c96",31:"#2e6c96",36:"#2e6c96",37:"#2e6c96",41:"#2e6c96",42:"#2e6c96",47:"#2e6c96",48:"#2e6c96",5:"#3a8a4e",6:"#3a8a4e",11:"#3a8a4e",16:"#3a8a4e",17:"#3a8a4e",21:"#3a8a4e",22:"#3a8a4e",27:"#3a8a4e",28:"#3a8a4e",32:"#3a8a4e",33:"#3a8a4e",38:"#3a8a4e",39:"#3a8a4e",43:"#3a8a4e",44:"#3a8a4e",49:"#3a8a4e"}[n];
  return '<span class="ball-sm spec" style="background:'+c+'">'+n+'</span><span style=font-size:13px;color:var(--gold);font-weight:600>'+z+'</span>';
}
var _zn = ["鼠","牛","虎","兔","龙","蛇","马","羊","猴","鸡","狗","猪"];
function go(p){if(p<1)return;HP=p;render();}
document.getElementById("search").addEventListener("input",function(){HP=1;render();});
document.getElementById("filter").addEventListener("change",function(){HP=1;render();});
render();
window.go = go;
</script>
